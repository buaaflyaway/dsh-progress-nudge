{
  "name": "dsh-progress-nudge",
  "version": "0.2.0",
  "description": "Keeps a quiet agent reportable: counts consecutive tool-only rounds and injects a short progress reminder into the next model request, with a Settings page for threshold, wording, language, and Agent Teams scope.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/screenshots/*.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "progress",
    "reminder",
    "agent-loop",
    "agent-teams",
    "settings"
  ],
  "author": "NedFlanders",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buaaflyaway/dsh-progress-nudge.git"
  },
  "bugs": {
    "url": "https://github.com/buaaflyaway/dsh-progress-nudge/issues"
  },
  "homepage": "https://github.com/buaaflyaway/dsh-progress-nudge#readme"
}
